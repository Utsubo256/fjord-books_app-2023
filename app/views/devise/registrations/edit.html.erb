<h2><%= t("devise.registrations.edit.title", resource: resource_name.capitalize.to_s.constantize.model_name.human) %></h2>

<%= render "form", resource: resource %>

<h3><%= t("devise.registrations.edit.cancel_my_account") %></h3>

<div><%= t("devise.registrations.edit.unhappy") %> <%= button_to t("devise.registrations.edit.cancel_my_account"), registration_path(resource_name), data: { confirm: t("devise.registrations.edit.are_you_sure"), turbo_confirm: t("devise.registrations.edit.are_you_sure") }, method: :delete %></div>

<%= link_to t('devise.shared.links.back'), :back %>
